<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>idpremiolote</name>
        <type>integer</type>
    </column>
    <column>
        <name>idsorteo</name>
        <type>integer</type>
    </column>
    <column>
        <name>idtalonario</name>
        <type>integer</type>
    </column>
    <column>
        <name>numero</name>
        <type>integer</type>
    </column>
    <column>
        <name>fecha_pago</name>
        <type>date</type>
    </column>
    <column>
        <name>importe</name>
        <type>numeric(14,2)</type>
        <default>0</default>
    </column>
    <column>
        <name>idpremioparticipacion</name>
        <type>serial</type>
        <null>NO</null>
    </column>

    <constraint>
        <name>premio_participaciones_pkey</name>
        <type>PRIMARY KEY (idpremioparticipacion)</type>
    </constraint>
    <constraint>
        <name>premio_participaciones_unique_numero</name>
        <type>UNIQUE (idsorteo, numero)</type>
    </constraint>
</table>