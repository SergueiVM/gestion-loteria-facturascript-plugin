{% extends "Master/MenuBghTemplate.html.twig" %}

{% block body %}
    <div class="bg-light pt-4 pb-5">
        <div class="container pb-4">
            <a href="ListParticipacionAnulada" class="btn btn-sm btn-outline-secondary mb-2">
                <i class="fa-solid fa-arrow-left me-1"></i>{{ trans('anulacion-participaciones') }}
            </a>
            <h1 class="h4 mb-0"><i class="fa-solid fa-ban fa-fw"></i> {{ trans('anular-participaciones') }}</h1>
            <p class="text-muted mb-0 mt-2">{{ trans('anular-participaciones-help') }}</p>
        </div>
    </div>

    <div class="container" style="margin-top: -3rem;">
        <div class="row g-3 mb-5">
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body">
                        {% if fsc.sorteos is empty %}
                            <p class="mb-0">{{ trans('no-sorteos-activos') }}</p>
                        {% else %}
                            <form action="EditParticipacionAnulada" method="post">
                                {{ formToken() }}
                                <input type="hidden" name="action" value="anular"/>

                                <div class="mb-3">
                                    <label for="idsorteo" class="form-label">{{ trans('sorteo') }}</label>
                                    <select id="idsorteo" name="idsorteo" class="form-select" required>
                                        {% for item in fsc.sorteos %}
                                            <option value="{{ item.idsorteo }}" {{ fsc.selectedSorteoId == item.idsorteo ? 'selected' : '' }}>{{ item.descripcion }}</option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="modo" id="modoUna" value="una" {{ fsc.modo == 'una' ? 'checked' : '' }}/>
                                        <label class="btn btn-outline-secondary" for="modoUna">{{ trans('una-participacion') }}</label>
                                        <input type="radio" class="btn-check" name="modo" id="modoRango" value="rango" {{ fsc.modo == 'rango' ? 'checked' : '' }}/>
                                        <label class="btn btn-outline-secondary" for="modoRango">{{ trans('rango-participaciones') }}</label>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col">
                                        <label for="desde" class="form-label" id="desdeLabel">{{ trans('participation-number') }}</label>
                                        <input type="number" min="0" step="1" id="desde" name="desde" value="{{ fsc.desde }}" class="form-control" required autofocus/>
                                    </div>
                                    <div class="col" id="hastaCol">
                                        <label for="hasta" class="form-label">{{ trans('hasta-numero') }}</label>
                                        <input type="number" min="0" step="1" id="hasta" name="hasta" value="{{ fsc.hasta }}" class="form-control"/>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col">
                                        <label for="motivo" class="form-label">{{ trans('motivo') }}</label>
                                        <select id="motivo" name="motivo" class="form-select" required>
                                            {% for item in fsc.getMotivos() %}
                                                <option value="{{ item }}" {{ fsc.motivo == item ? 'selected' : '' }}>{{ trans('motivo-' ~ item) }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col">
                                        <label for="fecha" class="form-label">{{ trans('fecha') }}</label>
                                        <input type="date" id="fecha" name="fecha" value="{{ fsc.fecha }}" class="form-control" required/>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="observaciones" class="form-label">{{ trans('observations') }}</label>
                                    <textarea id="observaciones" name="observaciones" rows="2" class="form-control">{{ fsc.observaciones }}</textarea>
                                </div>

                                <button type="submit" class="btn btn-danger w-100 btn-spin-action" {{ fsc.permissions.allowUpdate ? '' : 'disabled' }}>
                                    <i class="fa-solid fa-ban me-2"></i><span id="submitLabel">{{ trans('anular') }}</span>
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <i class="fa-solid fa-check me-2"></i>{{ trans('participaciones-anuladas-ahora') }}
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                            <tr>
                                <th>{{ trans('participation-number') }}</th>
                                <th>{{ trans('talonario') }}</th>
                                <th>{{ trans('motivo') }}</th>
                                <th>{{ trans('fecha') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for item in fsc.registradas %}
                                <tr>
                                    <td class="fw-semibold">{{ item.numero }}</td>
                                    <td><a href="EditTalonario?code={{ item.idtalonario }}">{{ item.idtalonario }}</a></td>
                                    <td>{{ trans('motivo-' ~ item.motivo) }}</td>
                                    <td>{{ item.fecha }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">{{ trans('no-data') }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const rango = document.getElementById('modoRango');
            if (!rango) return;
            const hastaCol = document.getElementById('hastaCol');
            const hasta = document.getElementById('hasta');
            const desdeLabel = document.getElementById('desdeLabel');

            function update() {
                const isRango = rango.checked;
                hastaCol.classList.toggle('d-none', !isRango);
                hasta.required = isRango;
                desdeLabel.textContent = isRango ? '{{ trans('desde-numero')|e('js') }}' : '{{ trans('participation-number')|e('js') }}';
            }

            document.querySelectorAll('input[name="modo"]').forEach(el => el.addEventListener('change', update));
            update();
        })();
    </script>
{% endblock %}
