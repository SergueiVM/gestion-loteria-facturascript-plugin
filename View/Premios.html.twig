{% extends "Master/MenuBghTemplate.html.twig" %}

{% block body %}
    <div class="bg-light pt-4 pb-5">
        <div class="container pb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h1 class="h4 mb-0">
                        <i class="fa-solid fa-trophy fa-fw"></i> {{ trans('premios') }}
                    </h1>
                    <p class="text-muted mb-0 mt-2">{{ trans('premios-help') }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container" style="margin-top: -40px;">
        <div class="row g-4">
            <div class="col-12 col-xl-5">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <form action="{{ fsc.url() }}" method="post">
                            {{ formToken() }}
                            <input type="hidden" name="action" value="register-premios"/>

                            <div class="mb-3">
                                <label for="idsorteo" class="form-label">{{ trans('sorteo') }}</label>
                                <select id="idsorteo" name="idsorteo" class="form-select" required>
                                    <option value="0">------</option>
                                    {% for sorteo in fsc.sorteos %}
                                        <option value="{{ sorteo.idsorteo }}" {{ fsc.selectedSorteoId == sorteo.idsorteo ? 'selected' : '' }}>
                                            {{ sorteo.label }}{% if sorteo.fecha %} · {{ sorteo.fecha }}{% endif %}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="participaciones" class="form-label">{{ trans('participations') }}</label>
                                <textarea
                                    id="participaciones"
                                    name="participaciones"
                                    class="form-control"
                                    rows="10"
                                    placeholder="{{ trans('premios-input-placeholder') }}"
                                    required>{{ fsc.participacionesInput }}</textarea>
                                <div class="form-text">{{ trans('premios-input-help') }}</div>
                            </div>

                            {% if fsc.selectedSorteo %}
                                <div class="alert alert-info mb-3">
                                    <div><strong>{{ trans('descripcion') }}:</strong> {{ fsc.selectedSorteo.descripcion }}</div>
                                    <div><strong>{{ trans('importe-premio') }}:</strong> {{ fsc.selectedSorteo.importe_premio|number_format(2, ',', '.') }} €</div>
                                </div>
                            {% endif %}

                            <button type="submit" class="btn btn-primary btn-spin-action">
                                <i class="fa-solid fa-check me-2"></i>{{ trans('process-premios') }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-7">
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <form action="{{ fsc.url() }}" method="get" class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label for="filter_idsorteo" class="form-label">{{ trans('sorteo') }}</label>
                                <select id="filter_idsorteo" name="idsorteo" class="form-select">
                                    <option value="0">------</option>
                                    {% for sorteo in fsc.sorteos %}
                                        <option value="{{ sorteo.idsorteo }}" {{ fsc.selectedSorteoId == sorteo.idsorteo ? 'selected' : '' }}>
                                            {{ sorteo.label }}{% if sorteo.fecha %} · {{ sorteo.fecha }}{% endif %}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="desde" class="form-label">{{ trans('from-date') }}</label>
                                <input id="desde" name="desde" type="date" class="form-control" value="{{ fsc.filterDesde }}"/>
                            </div>
                            <div class="col-md-3">
                                <label for="hasta" class="form-label">{{ trans('to-date') }}</label>
                                <input id="hasta" name="hasta" type="date" class="form-control" value="{{ fsc.filterHasta }}"/>
                            </div>
                            <div class="col-md-6">
                                <label for="buscar" class="form-label">{{ trans('search') }}</label>
                                <input id="buscar" name="buscar" type="text" class="form-control" value="{{ fsc.filterSearch }}" placeholder="{{ trans('premios-search-placeholder') }}"/>
                            </div>
                            <div class="col-md-6 d-flex gap-2">
                                <button type="submit" class="btn btn-outline-primary">
                                    <i class="fa-solid fa-magnifying-glass me-2"></i>{{ trans('search') }}
                                </button>
                                <a href="{{ fsc.url() }}{% if fsc.selectedSorteoId > 0 %}?idsorteo={{ fsc.selectedSorteoId }}{% endif %}" class="btn btn-outline-secondary">
                                    <i class="fa-solid fa-rotate-left me-2"></i>{{ trans('clean') }}
                                </a>
                            </div>
                        </form>
                        <div class="form-text mt-2">{{ trans('premios-search-help') }}</div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">{{ trans('importe-premio') }}</div>
                                <div class="fs-4 fw-semibold">{{ fsc.selectedSorteo ? fsc.selectedSorteo.importe_premio|number_format(2, ',', '.') ~ ' €' : '-' }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">{{ trans('paid-participations-total') }}</div>
                                <div class="fs-4 fw-semibold">{{ fsc.totals.count }}</div>
                                <div class="small text-muted mt-1">{{ trans('filtered-period') }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">{{ trans('paid-amount-total') }}</div>
                                <div class="fs-4 fw-semibold">{{ fsc.totals.amount|number_format(2, ',', '.') }} €</div>
                                <div class="small text-muted mt-1">{{ fsc.filterDesde }} - {{ fsc.filterHasta }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                {% if fsc.processResult.savedCount is defined and fsc.processResult.savedCount > 0 %}
                    <div class="card shadow-sm mb-3 border-success">
                        <div class="card-body">
                            <h2 class="h6 mb-3">{{ trans('last-processed-batch') }}</h2>
                            <p class="mb-2">
                                {{ trans('batch') }} #{{ fsc.processResult.batchId }}
                                · {{ trans('participations') }}: {{ fsc.processResult.savedCount }}
                                · {{ trans('amount') }}: {{ fsc.processResult.totalAmount|number_format(2, ',', '.') }} €
                            </p>

                            {% if fsc.processResult.saved is not empty %}
                                <div class="mb-2">
                                    <strong>{{ trans('saved-participations') }}:</strong>
                                    {% for item in fsc.processResult.saved %}
                                        <span class="me-1">{{ item.numero }}{{ not loop.last ? ',' : '' }}</span>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if fsc.processResult.invalidTokens is not empty %}
                                <div class="mb-2 text-danger"><strong>{{ trans('invalid-values') }}:</strong> {{ fsc.processResult.invalidTokens|join(', ') }}</div>
                            {% endif %}
                            {% if fsc.processResult.duplicateInput is not empty %}
                                <div class="mb-2 text-warning"><strong>{{ trans('duplicate-input-values') }}:</strong> {{ fsc.processResult.duplicateInput|join(', ') }}</div>
                            {% endif %}
                            {% if fsc.processResult.notFound is not empty %}
                                <div class="mb-2 text-warning"><strong>{{ trans('not-found-in-paid-booklets') }}:</strong> {{ fsc.processResult.notFound|join(', ') }}</div>
                            {% endif %}
                            {% if fsc.processResult.ambiguous is not empty %}
                                <div class="mb-2 text-warning"><strong>{{ trans('duplicated-in-paid-booklets') }}:</strong> {{ fsc.processResult.ambiguous|join(', ') }}</div>
                            {% endif %}
                            {% if fsc.processResult.alreadyPaid is not empty %}
                                <div class="mb-0 text-warning">
                                    <strong>{{ trans('already-paid-participations') }}:</strong>
                                    {% for item in fsc.processResult.alreadyPaid %}
                                        <span class="me-2">{{ item.numero }} ({{ trans('batch') }} #{{ item.idpremiolote }}, {{ item.fecha_pago }})</span>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                <div class="card shadow-sm mb-3">
                    <div class="card-header">
                        <i class="fa-solid fa-calendar-days me-2"></i>{{ trans('daily-paid-summary') }}
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                            <tr>
                                <th>{{ trans('fecha') }}</th>
                                <th class="text-end">{{ trans('participations') }}</th>
                                <th class="text-end">{{ trans('amount') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if fsc.dailySummary is empty %}
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-3">{{ trans('no-data') }}</td>
                                </tr>
                            {% else %}
                                {% for row in fsc.dailySummary %}
                                    <tr>
                                        <td>{{ row.fecha_pago }}</td>
                                        <td class="text-end">{{ row.cantidad }}</td>
                                        <td class="text-end">{{ row.importe_total|number_format(2, ',', '.') }} €</td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card shadow-sm mb-3">
                    <div class="card-header">
                        <i class="fa-solid fa-layer-group me-2"></i>{{ trans('payment-batches') }}
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                            <tr>
                                <th>{{ trans('batch') }}</th>
                                <th>{{ trans('fecha') }}</th>
                                <th class="text-end">{{ trans('participations') }}</th>
                                <th class="text-end">{{ trans('amount') }}</th>
                                <th>{{ trans('participations') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if fsc.batchList is empty %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">{{ trans('no-data') }}</td>
                                </tr>
                            {% else %}
                                {% for row in fsc.batchList %}
                                    <tr>
                                        <td>#{{ row.idpremiolote }}</td>
                                        <td>{{ row.fecha_pago }}</td>
                                        <td class="text-end">{{ row.cantidad_participaciones }}</td>
                                        <td class="text-end">{{ row.importe_total|number_format(2, ',', '.') }} €</td>
                                        <td class="small">{{ row.numeros }}</td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header">
                        <i class="fa-solid fa-ticket me-2"></i>{{ trans('paid-participations') }}
                    </div>
                    <div class="card-body border-bottom py-2 small text-muted">
                        {{ trans('premios-participations-search-help') }}
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                            <tr>
                                <th>{{ trans('participation-number') }}</th>
                                <th>{{ trans('fecha') }}</th>
                                <th>{{ trans('batch') }}</th>
                                <th>{{ trans('talonario') }}</th>
                                <th class="text-end">{{ trans('amount') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if fsc.paidParticipations is empty %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">{{ trans('no-data') }}</td>
                                </tr>
                            {% else %}
                                {% for row in fsc.paidParticipations %}
                                    <tr>
                                        <td>{{ row.numero }}</td>
                                        <td>{{ row.fecha_pago }}</td>
                                        <td>#{{ row.idpremiolote }}</td>
                                        <td>
                                            {% if row.idtalonario %}
                                                #{{ row.idtalonario }}
                                                {% if row.nro_inicio is not null and row.nro_fin is not null %}
                                                    <span class="text-muted">({{ row.nro_inicio }}-{{ row.nro_fin }})</span>
                                                {% endif %}
                                            {% else %}
                                                -
                                            {% endif %}
                                        </td>
                                        <td class="text-end">{{ row.importe|number_format(2, ',', '.') }} €</td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}