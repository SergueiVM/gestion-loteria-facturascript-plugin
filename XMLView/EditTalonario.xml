<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <group name="main" numcolumns="12">
            <column name="code" display="none" order="100">
                <widget type="text" fieldname="idtalonario" />
            </column>

            <column name="sorteo" numcolumns="3" order="110">
                <widget type="select" fieldname="idsorteo" onclick="EditSorteo" required="true">
                    <values source="Sorteo" fieldcode="idsorteo" fieldtitle="descripcion" />
                </widget>
            </column>

            <column name="nro_inicio" numcolumns="3" order="120">
                <widget type="number" fieldname="nro_inicio" decimal="0" />
            </column>

            <column name="nro_fin" numcolumns="3" order="130">
                <widget type="number" fieldname="nro_fin" decimal="0" />
            </column>

            <column name="contacto" numcolumns="3" order="140">
                <widget type="autocomplete" fieldname="idcontacto" onclick="EditContacto">
                    <values source="Contacto" fieldcode="idcontacto" />
                </widget>
            </column>
        </group>

        <group name="totals" numcolumns="12">
            <column name="vendidas" numcolumns="2" order="150">
                <widget type="number" fieldname="vendidas" decimal="0" />
            </column>

            <column name="no_vendidas" numcolumns="2" order="160">
                <widget type="number" fieldname="no_vendidas" decimal="0" />
            </column>

            <column name="total-participaciones" display="right" numcolumns="3" order="170">
                <widget type="number" fieldname="total_participaciones" decimal="0" readonly="true" />
            </column>

            <column name="precio-talonario" display="right" numcolumns="5" order="180">
                <widget type="money" fieldname="precio_talonario" readonly="true" />
            </column>
        </group>

        <group name="checks" numcolumns="12">
            <column name="omitir-pago-donativo-no-vendidas" numcolumns="4" order="190">
                <widget type="checkbox" fieldname="omitir_pago_donativo_no_vendidas" />
            </column>

            <column name="matriz-entregada" numcolumns="4" order="200">
                <widget type="checkbox" fieldname="matriz_entregada" />
            </column>

            <column name="pagado" numcolumns="4" order="210">
                <widget type="checkbox" fieldname="pagado" />
            </column>
        </group>
    </columns>
</view>
